# =============================================================================
# you2ube environment configuration
# =============================================================================
# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# NEVER commit `.env` to git — it contains credentials.
# `.env` is already listed in `.gitignore`.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the app will refuse to start without this
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev example:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Production example (Supabase pooled connection):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# -----------------------------------------------------------------------------
# OPTIONAL — features degrade gracefully if missing
# -----------------------------------------------------------------------------

# Public URL of the deployed app. Used for:
#   - Discord OAuth redirect URI
#   - robots.txt / sitemap.xml absolute URLs
#   - Auto-update publishing
#
# Local dev default is http://localhost:3000. In production set to your
# real public URL (e.g. https://you2ube.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discord OAuth (Phase 7). Create an app at https://discord.com/developers/applications
# and add a redirect URI matching `${NEXT_PUBLIC_APP_URL}/api/auth/discord/callback`.
# Leave blank to disable Discord features entirely.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=
DISCORD_RPC_CLIENT_ID=

# Electron dev server URL (only used by `scripts/electron-dev.sh`).
# Defaults to http://localhost:3000 if not set.
DEV_SERVER_URL=http://localhost:3000

# Port used by the Next.js server spawned inside the Electron main process
# in production. Defaults to 3001 to avoid clashing with dev server.
YOU2UBE_PORT=3001
